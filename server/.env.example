# ============================================================
# stock-monitor 服务端配置模板（复制为 .env 后填写真实值）
# .env 已被 .gitignore 忽略，切勿提交真实密码到仓库
# ============================================================

# PostgreSQL 连接串（用户/密码/端口/库名按本机实际填写）
DATABASE_URL=postgres://postgres:请改密码@127.0.0.1:5432/stock_monitor

# 服务端口（本地页面访问 http://localhost:8080）
PORT=8080

# ---- LLM（Agnes 2.5 Flash）----
# 模型 API Key 只存服务端；留空 = 前端回退本地 Key（不推荐）
# 国际站用户 Endpoint 用 https://apihub.agnes-ai.cn/v1 即可继续用原 Key + 原模型
AI_BASE_URL=https://apihub.agnes-ai.cn/v1
AI_MODEL=agnes-2.5-flash
AI_API_KEY=
AI_PROVIDER=openai

# 可选：代理（Clash 等），留空 = 直连
# HTTPS_PROXY=http://127.0.0.1:7897
